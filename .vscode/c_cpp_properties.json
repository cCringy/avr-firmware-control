{
    "configurations": [
        {
            "name": "AVR",
            "compilerPath": "D:/avr-gcc/bin/avr-gcc.exe",
            "includePath": [
                "${workspaceFolder}/app",
                "${workspaceFolder}/bsp",
                "${workspaceFolder}/hal",
                "${workspaceFolder}/dsp",
                "${workspaceFolder}/util"
            ],
            "defines": [
                "__AVR_ATmega328P__",
                "F_CPU=16000000UL",
                "UART_FRAMESIZE=8"
            ],
            "cStandard": "gnu99",
            "intelliSenseMode": "gcc-x64"
        }
    ],
    "version": 4
}